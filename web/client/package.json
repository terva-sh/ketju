{
  "name": "ketju-client",
  "private": true,
  "type": "module",
  "description": "The Preact client. Built into internal/web/spa/dist and embedded in the ketju binary; see README.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/budget.mjs",
    "budget": "node scripts/budget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "preact": "10.29.8",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
